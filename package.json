{
  "name": "ozy-multi-media-player",
  "version": "0.2.0",
  "buildVersion": "0.2.0.3",
  "description": "Local multi-video player and comparison board with YouTube/Twitch tiles",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "prefetch": "node scripts/fetch-ytdlp.js",
    "dist": "node scripts/fetch-ytdlp.js && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.ozy.multimediaplayer",
    "productName": "Ozy Multi Media Player",
    "buildVersion": "0.2.0.3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "style.css",
      "lib/**/*",
      "!lib/**/*.test.js"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "bin/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffprobe-static/bin/win32/${arch}/ffprobe.exe",
          "to": "bin/ffprobe.exe"
        },
        {
          "from": "bin/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null,
      "artifactName": "OzyMultiMediaPlayer-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "bin/darwin-${arch}/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "node_modules/ffprobe-static/bin/darwin/${arch}/ffprobe",
          "to": "bin/ffprobe"
        },
        {
          "from": "bin/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "CaptainSamus",
      "repo": "OzyMultiMediaPlayer"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OzyMultiMediaPlayer-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "OzyMultiMediaPlayer-${version}-portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "mvp",
        "name": "Ozy Multi Media Player session",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
